# Yerel gelistirme varsayilani. Bu adapter Vercel'de kullanilamaz.
MRAP_DATA_PROVIDER=sqlite
MRAP_CANONICAL_ORIGIN=http://localhost:3000
MRAP_TRUST_PROXY_HEADERS=0
MRAP_SQLITE_FILENAME=mrap.sqlite

# Server-authoritative oyun dunyalari ve canonical tile grid.
MRAP_PRODUCTION_WORLD_ID=world-main
MRAP_DEVELOPMENT_WORLD_ID=development-sandbox
MRAP_CELL_ZOOM=22
MRAP_REGION_ZOOM=14
MRAP_MAX_CANDIDATE_CELLS=25000
MRAP_MAX_VIEWPORT_REGIONS=64

# Rekabetci rota oturumu ve konum dogrulama sinirlari.
MRAP_SESSION_LEASE_SECONDS=1800
MRAP_CANDIDATE_TTL_SECONDS=300
MRAP_MIN_CLAIM_DURATION_SECONDS=3
MRAP_COMPETITIVE_MAX_POINTS=10000
MRAP_MAX_POINT_BATCH=100
MRAP_MAX_POINT_BATCH_BYTES=96000
MRAP_MAX_GPS_ACCURACY_M=65
MRAP_SUSPICIOUS_GPS_ACCURACY_M=35
MRAP_MIN_POINT_SPACING_M=2
MRAP_MAX_REAL_SPEED_MPS=12
MRAP_SUSPICIOUS_REAL_SPEED_MPS=8
MRAP_MAX_SIM_SPEED_MPS=125
MRAP_MAX_ACCELERATION_MPS2=12
MRAP_MAX_CLIENT_BACKFILL_SECONDS=30
MRAP_MAX_CLIENT_FUTURE_SKEW_SECONDS=10
MRAP_INITIAL_SAMPLE_GRACE_SECONDS=15
MRAP_SUBSEQUENT_SAMPLE_GRACE_SECONDS=1
MRAP_MAX_TRACKING_GAP_SECONDS=20
MRAP_SERVER_DISTANCE_BUDGET_SLACK_M=10
MRAP_MAX_CLAIM_RISK_SCORE=15
MRAP_MIN_POINT_INTERVAL_MS=150
MRAP_MAX_SUSPICIOUS_POINT_RATIO=0.5

# Loop, geometri ve benzersiz territory kurallari.
MRAP_REAL_LOOP_PROXIMITY_M=12
MRAP_SIM_LOOP_PROXIMITY_M=4
MRAP_MIN_LOOP_AREA_M2=35
MRAP_MIN_LOOP_ROUTE_M=25
MRAP_MIN_LOOP_INDEX_GAP=4
MRAP_LOOP_COOLDOWN_MS=4500
MRAP_MAX_CLAIM_AREA_M2=25000000
MRAP_MAX_CLAIM_BBOX_KM=15
MRAP_MAX_CLAIM_ASPECT_RATIO=150
MRAP_MAX_CLAIM_VERTICES=3500
MRAP_MIN_CLAIM_CELL_COUNT=1
MRAP_MAX_AREA_PER_ROUTE_METER_M2=5000

# Realtime, retention, rate limit ve transaction ayarlari.
MRAP_MAX_INLINE_PATCH_CELLS=350
MRAP_MAX_REALTIME_REPLAY_EVENTS=2000
MRAP_STREAM_POLL_MS=750
MRAP_STREAM_HEARTBEAT_MS=15000
MRAP_RAW_LOCATION_RETENTION_DAYS=30
MRAP_SHARED_IP_RATE_LIMIT_MULTIPLIER=20
MRAP_SESSION_STARTS_PER_HOUR=20
MRAP_POINT_BATCHES_PER_MINUTE=120
MRAP_CANDIDATES_PER_MINUTE=30
MRAP_CLAIMS_PER_TEN_MINUTES=40
MRAP_SNAPSHOTS_PER_MINUTE=120
MRAP_REALTIME_SUBSCRIPTIONS_PER_MINUTE=30
MRAP_TRANSACTION_MAX_RETRIES=3
MRAP_TRANSACTION_RETRY_BASE_DELAY_MS=20
MRAP_TRANSACTION_RETRY_JITTER_MS=25

# Hesap silme istegi ve brute-force sinirlari.
MRAP_ACCOUNT_DELETE_MAX_BODY_BYTES=512
MRAP_ACCOUNT_DELETE_RATE_LIMIT=5
MRAP_ACCOUNT_DELETE_RATE_WINDOW_MS=3600000

# Eski acik rota kayit endpointi icin bounded saklama kurallari.
MRAP_ROUTE_SESSION_MAX_POINTS=10000
MRAP_ROUTE_SESSION_MAX_DISTANCE_M=250000
MRAP_ROUTE_SESSION_MAX_DURATION_SECONDS=86400
MRAP_ROUTE_SESSION_MAX_REAL_SPEED_MPS=12
MRAP_ROUTE_SESSION_MAX_DEV_SPEED_MPS=100

# Supabase production baglantisi. Bu degerler bilerek bostur.
# Publishable key tarayiciya acilabilir; secret key ve database URL acilamaz.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sunucu tarafindaki Supabase istemcileri icin canonical proje URL'si.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=kpsiqurdxumsouimjmvc
SUPABASE_DATABASE_URL=
SUPABASE_MEDIA_BUCKET=mrap-media

# Vercel Cron isteklerini dogrular. Production'da en az 16 karakterlik rastgele bir sir kullanin.
CRON_SECRET=

# Production build'lerinde gelistirici GPS kontrolleri kapali kalmalidir.
NEXT_PUBLIC_MRAP_DEVELOPER_CONTROLS=false
NEXT_PUBLIC_MRAP_PRODUCTION_WORLD_ID=world-main
NEXT_PUBLIC_MRAP_REGION_ZOOM=14
NEXT_PUBLIC_MRAP_MAX_VIEWPORT_REGIONS=64
NEXT_PUBLIC_MRAP_MAP_LOAD_TIMEOUT_MS=12000
# Gonderi yayinlama UX zaman asimi; 5000-60000 ms disi degerler 20000 ms varsayilanina doner.
NEXT_PUBLIC_MRAP_POST_PUBLISH_TIMEOUT_MS=20000

# Oyun kurallari. Production'da ayni kurallar PostGIS tarafinda da uygulanir.
NEXT_PUBLIC_MRAP_MIN_POINT_SPACING_M=2
NEXT_PUBLIC_MRAP_MAX_GPS_ACCURACY_M=65
NEXT_PUBLIC_MRAP_REAL_LOOP_PROXIMITY_M=12
NEXT_PUBLIC_MRAP_SIM_LOOP_PROXIMITY_M=4
NEXT_PUBLIC_MRAP_MIN_LOOP_AREA_M2=35
NEXT_PUBLIC_MRAP_MIN_LOOP_ROUTE_M=25
NEXT_PUBLIC_MRAP_MIN_LOOP_INDEX_GAP=4
NEXT_PUBLIC_MRAP_LOOP_COOLDOWN_MS=4500

# Opsiyonel sifre yenileme e-postasi. Yerelde bos birakilabilir.
RESEND_API_KEY=
MRAP_EMAIL_FROM=
# Resend istegi icin 1000-15000 ms araliginda sunucu zaman asimi.
MRAP_EMAIL_TIMEOUT_MS=8000

# Yalnizca yerel kalite/simulator komutlari. Production runtime degiskeni degildir.
MRAP_SIMULATOR_BASE_URL=http://localhost:3000
MRAP_SIMULATOR_LATENCY_MS=0
MRAP_SIMULATOR_PACKET_LOSS=0
MRAP_SMOKE_BASE_URL=http://localhost:3100
# Uzak Supabase projesinde gecici QA kullanicilari olusturan smoke testi icin bilincli olarak 1 yapilir.
MRAP_ALLOW_REMOTE_SMOKE=0
# Uzak smoke sosyal tabloları da kullandığı için yalnız canlı kullanıcı içermeyen QA projesinde 1 yapılır.
MRAP_SMOKE_ISOLATED_PROJECT=0
# Uzak smoke varsayilani development_simulation; yerel SQLite varsayilani real_gps'tir.
MRAP_SMOKE_LOCATION_MODE=
# Yalniz izole ve bos bir QA projesinde production world claim'i icin iki deger de bilincli girilir.
MRAP_ALLOW_PRODUCTION_WORLD_SMOKE=0
MRAP_SMOKE_EXPECTED_PROJECT_REF=
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100
PLAYWRIGHT_PORT=3100

# NODE_ENV, CI ve VERCEL platform tarafindan otomatik saglanir; elle sabitlenmez.
# Vercel dışında üretim sözleşmesini doğrulayan staging testleri için 1 yapılır.
MRAP_ENFORCE_PRODUCTION_CONFIG=0

# Yalnizca altyapi otomasyonu icin; uygulama runtime'inda gerekmez.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Turnstile. Yerelde uc deger birlikte tanimlandiginda etkinlesir;
# production'da uc deger de zorunludur ve eksik yapilandirma fail-closed davranir.
# Site key tarayici paketine girer; secret ve hostname listesi yalniz sunucuda kalir.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
MRAP_TURNSTILE_EXPECTED_HOSTNAMES=
